      "keyword" : "end_date",
      "dataType" : "DATE",
      "defaultSelection" : {
        "values" : {
          "dataType" : "DATE",
          "values" : [ {
            "value" : "2024-04-29T00:00:00.000"
          } ]
        }
      }
    } ]
