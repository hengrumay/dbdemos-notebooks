    "displayName" : "dbdemos HLS - Patients by State",
    "query" : "-- [original title] Map - dbdemos HLS - Patients by State\n\nSELECT NVL(state, 'XX' ) state_abbr, \n    count(*) as Num_Persons_count\nfrom `mmt_demos`.`hls_readmission_dbdemoinit`.patients p\nWHERE p.BIRTHDATE BETWEEN :start_date AND :end_date\nGROUP BY state_abbr\nORDER BY 1;",
