  }, {
    "name" : "c53be963",
    "displayName" : "dbdemos HLS - patient summary",
    "query" : "SELECT c.concept_name gender, p.day_of_birth, p.month_of_birth, p.year_of_birth, COUNT(person_id) AS num_persons_count\nFROM `mmt_demos`.`hls_readmission_dbdemoinit`.person p\nLEFT JOIN `mmt_demos`.`hls_readmission_dbdemoinit`.concept c ON c.concept_id = p.gender_concept_id\nWHERE birth_datetime BETWEEN :start_date AND :end_date \nGROUP BY c.concept_name, p.day_of_birth, p.month_of_birth, p.year_of_birth\nORDER BY p.year_of_birth ASC",
    "parameters" : [ {
      "displayName" : "start_date",
      "keyword" : "start_date",
      "dataType" : "DATE",
      "defaultSelection" : {
        "values" : {
          "dataType" : "DATE",
          "values" : [ {
            "value" : "2021-04-01T00:00:00.000"
          } ]
        }
      }
    }, {
